<Window x:Class="NexIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexIsland.ViewModels"
        Title="NexIsland"
        Icon="Assets/Branding/NexIslandIcon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="{Binding Width, Mode=TwoWay, FallbackValue=390}"
        Height="{Binding Height, Mode=TwoWay, FallbackValue=220}"
        AllowDrop="True"
        Drop="Window_Drop"
        Deactivated="Window_Deactivated"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <!-- Outer Atmospheric Glow & Dynamic Capsule -->
    <Border x:Name="CapsuleBorder"
            Background="{StaticResource IslandCapsuleBgGradient}"
            BorderBrush="{StaticResource IslandCapsuleBorderGradient}"
            BorderThickness="1.5"
            CornerRadius="{Binding IslandCornerRadius}"
            Opacity="{Binding Opacity}"
            ClipToBounds="True"
            Cursor="Arrow">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <!-- Top Subtle Specular Highlight -->
            <Border VerticalAlignment="Top" Height="1" Margin="24,0,24,0" Opacity="0.22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0.0"/>
                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ============================================== -->
            <!-- 1. COMPACT CAPSULE STATE (Minimalist Pill)     -->
            <!-- ============================================== -->
            <Grid x:Name="CompactPanel" Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}" Margin="8,0" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Section: Cover Art or Vector Icon + Waveform -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0">
                    <Border Width="26" Height="26" CornerRadius="8" Background="#14141C" BorderBrush="#262636" BorderThickness="1" ClipToBounds="True" Margin="0,0,6,0">
                        <Grid>
                            <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
                            <Image Source="Assets/Branding/NexIslandIcon.png" Width="18" Height="18" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoAlbumArt, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Real Audio Waveform Bars with Electric Blue - Violet Gradient -->
                    <ItemsControl ItemsSource="{Binding VisualizerBars}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="2.2" Height="{Binding}" Background="{StaticResource IslandAccentGradient}"
                                        CornerRadius="1.1" Margin="1,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Center Section: Dynamic Module Title or Song Title or Lyric Line -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,6,0" ClipToBounds="True">
                    <!-- Music Mode Title -->
                    <TextBlock Text="{Binding SongTitle}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IslandForegroundBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsMusicModule, Converter={StaticResource BoolToVis}}"/>

                    <!-- Lyrics Mode Compact Line -->
                    <TextBlock Text="{Binding CurrentLyricLine}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IslandAccentPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsLyricsModule, Converter={StaticResource BoolToVis}}"/>

                    <!-- Focus Mode Compact Text -->
                    <TextBlock Text="{Binding FocusTimeFormatted, StringFormat='Focus: {0}'}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource IslandAccentPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsFocusModule, Converter={StaticResource BoolToVis}}"/>

                    <!-- Generic Module Title for other modules in compact mode -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveModuleName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource IslandMutedForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMusicModule}" Value="False"/>
                                                <Condition Binding="{Binding IsLyricsModule}" Value="False"/>
                                                <Condition Binding="{Binding IsFocusModule}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Right Section: Badges (Weather, Battery, Chevron) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                    <!-- Weather Mini Badge -->
                    <Border Background="#12121A" CornerRadius="9" Padding="6,2" Margin="0,0,5,0" BorderBrush="#1F1F2C" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoWeather}" Fill="#F59E0B" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding WeatherTempText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource IslandMutedForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Battery Mini Badge -->
                    <Border Background="#12121A" CornerRadius="9" Padding="6,2" Margin="0,0,5,0" BorderBrush="#1F1F2C" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoBattery}" Fill="{StaticResource IslandMutedForegroundBrush}" Width="10" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource IslandMutedForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Subtle Expand Chevron -->
                    <TextBlock Text="▾" FontSize="11" Foreground="{StaticResource IslandDimForegroundBrush}" VerticalAlignment="Center" Margin="1,0,2,0"/>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- 2. NOTIFICATION BANNER STATE                   -->
            <!-- ============================================== -->
            <Grid x:Name="NotificationPanel" Visibility="{Binding IsNotificationState, Converter={StaticResource BoolToVis}}" Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{StaticResource IslandAccentGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoBell}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NotificationTitle}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding NotificationMessage}" FontSize="11.5" Foreground="{StaticResource IslandMutedForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- 3. EXPANDED FULL DASHBOARD STATE               -->
            <!-- ============================================== -->
            <Grid x:Name="ExpandedPanel" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Row: Brand Capsule, Swipe Navigation Controls & Collapse -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Capsule with Official NexIsland Logo/Icon -->
                    <Border Grid.Column="0" Background="#101015" CornerRadius="9" Padding="7,4" BorderBrush="#1C1C26" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/Branding/NexIslandIcon.png" Width="17" Height="17" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="NexIsland" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Interactive Swipe Navigation Capsule Indicator -->
                    <Border Grid.Column="1" Background="#101016" CornerRadius="10" Padding="8,3" BorderBrush="#1C1C28" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Previous Module Swipe Button -->
                                <Button Style="{StaticResource IslandWindowHeaderButtonStyle}" Command="{Binding PrevModuleCommand}" ToolTip="Previous Module (Left Arrow)" Width="24" Height="22" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoChevronLeft}" Stroke="{StaticResource IslandMutedForegroundBrush}" StrokeThickness="1.5" Width="6" Height="8" Stretch="Uniform"/>
                                </Button>

                                <!-- Active Module Title & Index (Click to Switch) -->
                                <Button Style="{StaticResource IslandGhostButtonStyle}" Command="{Binding NextModuleCommand}" ToolTip="Click to Cycle Module">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveModuleName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource IslandForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveModuleIndexText, StringFormat=' ({0})'}" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" VerticalAlignment="Center" Margin="3,0,4,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Realtime Live Status Indicator Pill -->
                                <Border Background="#14141E" CornerRadius="5" Padding="4,1.5" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="#202030" BorderThickness="1"
                                        ToolTip="{Binding ActiveModuleLiveDetail}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{Binding ActiveModuleLiveColor}" Margin="0,0,3.5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveModuleLiveBadge}" FontSize="8" FontWeight="Bold" Foreground="{Binding ActiveModuleLiveColor}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Next Module Swipe Button -->
                                <Button Style="{StaticResource IslandWindowHeaderButtonStyle}" Command="{Binding NextModuleCommand}" ToolTip="Next Module (Right Arrow)" Width="24" Height="22">
                                    <Path Data="{StaticResource GeoChevronRight}" Stroke="{StaticResource IslandMutedForegroundBrush}" StrokeThickness="1.5" Width="6" Height="8" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>

                            <!-- Minimalist Active Module Position Bar Indicator -->
                            <ProgressBar Value="{Binding ActiveModuleIndex, Mode=OneWay}" Minimum="0" Maximum="20" Height="2" Width="64"
                                         Background="#181824" Foreground="{StaticResource IslandAccentGradient}" BorderThickness="0" Margin="0,2,0,1" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Header Action Buttons (Only Collapse, No Settings Gear) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IslandWindowHeaderButtonStyle}" Command="{Binding CollapseCommand}" ToolTip="Collapse Island" Width="24" Height="22">
                            <Path Data="{StaticResource GeoClose}" Stroke="{StaticResource IslandMutedForegroundBrush}" StrokeThickness="1.5" Width="8" Height="8" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Expanded Content Area (Swipeable Modules) -->
                <Grid Grid.Row="1">
                    <!-- ============================================== -->
                    <!-- MODULE 1: MUSIC PLAYER                         -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsMusicModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Album Art Cover + Track Details -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="58" Height="58" CornerRadius="12" Background="#14141C" BorderBrush="#242432" BorderThickness="1" ClipToBounds="True" Margin="0,0,12,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
                                    <Path Data="{StaticResource GeoMusic}" Fill="#3B82F6" Width="22" Height="22" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding HasNoAlbumArt, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SongTitle}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ArtistName}" FontSize="11" Foreground="{StaticResource IslandMutedForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,5"/>

                                <!-- Live Waveform Bars Preview -->
                                <ItemsControl ItemsSource="{Binding VisualizerBars}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="2.5" Height="{Binding}" Background="{StaticResource IslandAccentGradient}"
                                                    CornerRadius="1.2" Margin="1.2,0" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- Scrubber Track & Real-Time Position / Duration with Seek -->
                        <Grid Grid.Row="1" Margin="0,6,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Interactive Scrubber: Background Track + Slider Overlay with Real Seek Support -->
                            <Grid Grid.Row="0" Height="14" VerticalAlignment="Center">
                                <ProgressBar Value="{Binding MediaProgress}" Minimum="0" Maximum="1" Height="4"
                                             Background="#161622" Foreground="{StaticResource IslandAccentGradient}" BorderThickness="0" VerticalAlignment="Center"/>
                                <Slider x:Name="MediaScrubberSlider" Style="{StaticResource IslandScrubberSliderStyle}" Minimum="0" Maximum="1"
                                        Value="{Binding MediaProgress, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        PreviewMouseDown="MediaScrubber_PreviewMouseDown"
                                        PreviewMouseMove="MediaScrubber_PreviewMouseMove"
                                        PreviewMouseUp="MediaScrubber_PreviewMouseUp"/>
                            </Grid>
                            
                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                <TextBlock Text="{Binding MediaPositionText}" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding MediaDurationText}" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <!-- Media Playback Buttons (Centered Hero Play/Pause) -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Previous Track Button -->
                            <Button Style="{StaticResource IslandMediaSecondaryButtonStyle}" Command="{Binding PrevTrackCommand}" ToolTip="Previous Track" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoPrev}" Fill="{StaticResource IslandForegroundBrush}" Width="11" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- HERO PLAY/PAUSE CENTERPIECE -->
                            <Button Style="{StaticResource IslandHeroPlayPauseButtonStyle}" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseTooltip}" Margin="12,0" VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Geometric Play Triangle (With Precision Optical Centering) -->
                                    <Path Data="{StaticResource GeoPlay}" Fill="#FFFFFF" Width="13" Height="16" Stretch="Uniform"
                                          Margin="2.5,0,0,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding IsNotPlaying, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Geometric Dual Pause Bars (Symmetric Precision) -->
                                    <Path Data="{StaticResource GeoPause}" Fill="#FFFFFF" Width="11" Height="15" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>

                            <!-- Next Track Button -->
                            <Button Style="{StaticResource IslandMediaSecondaryButtonStyle}" Command="{Binding NextTrackCommand}" ToolTip="Next Track" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoNext}" Fill="{StaticResource IslandForegroundBrush}" Width="11" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 2: LIVE LYRICS & KARAOKE                -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsLyricsModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header with Karaoke Badge -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="{Binding SongTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandDimForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                            <Border Background="#161622" CornerRadius="8" Padding="6,2" HorizontalAlignment="Right" BorderBrush="#252535" BorderThickness="1">
                                <TextBlock Text="Karaoke Live Sync" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentPrimaryBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Synchronized Lyric Lines in Glowing Centerpiece -->
                        <Border Grid.Row="1" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Previous Line -->
                                <TextBlock Text="{Binding PreviousLyricLine}" FontSize="11" Foreground="{StaticResource IslandDimForegroundBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" Opacity="0.5"/>

                                <!-- Active Line with Neon Glow (Click to Play/Pause) -->
                                <Button Style="{StaticResource IslandGhostButtonStyle}" Command="{Binding PlayPauseCommand}" ToolTip="Click to Play / Pause Music" HorizontalAlignment="Center">
                                    <Border Background="#181826" CornerRadius="10" Padding="14,8" BorderBrush="#3B82F6" BorderThickness="1.2">
                                        <TextBlock Text="{Binding CurrentLyricLine}" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="{StaticResource IslandForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </Border>
                                </Button>

                                <!-- Next Line -->
                                <TextBlock Text="{Binding NextLyricLine}" FontSize="11" Foreground="{StaticResource IslandDimForegroundBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Opacity="0.5"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 3: AUDIO VISUALIZER                     -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsVisualizerModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Full Spectrum Equalizer Bars -->
                        <Border Grid.Row="0" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="16">
                            <ItemsControl ItemsSource="{Binding VisualizerBars}" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="16" Height="{Binding}" Background="{StaticResource IslandAccentGradient}"
                                                CornerRadius="4" Margin="3.5,0" VerticalAlignment="Bottom">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" Color="#3B82F6" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Live WASAPI Loopback Capture • Hardware Audio Reactive" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 4: SYSTEM MONITOR                       -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsSystemModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Card -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,4,4">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0:F0}%'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding CpuUsage}" Minimum="0" Maximum="100" Height="4"
                                             Background="#1A1A24" Foreground="{StaticResource IslandAccentPrimaryBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM Card -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="10" Margin="4,0,0,4">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="MEMORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandSuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RamUsage, StringFormat='{}{0:F0}%'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding RamUsage}" Minimum="0" Maximum="100" Height="4"
                                             Background="#1A1A24" Foreground="{StaticResource IslandSuccessBrush}" BorderThickness="0"/>
                                <TextBlock Text="{Binding RamText}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Network Bandwidth Card -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,4,4,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NETWORK" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource IslandAccentSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding NetworkSpeedText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource IslandForegroundBrush}"/>
                                <TextBlock Text="{Binding NetworkStatus}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Disk Storage Card -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="10" Margin="4,4,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="STORAGE (C:)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource IslandWarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DiskUsage, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding DiskUsage}" Minimum="0" Maximum="100" Height="4"
                                             Background="#1A1A24" Foreground="{StaticResource IslandWarningBrush}" BorderThickness="0"/>
                                <TextBlock Text="{Binding DiskText}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 5: SMART BATTERY                        -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsBatteryModule, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource GeoBattery}" Fill="{StaticResource IslandSuccessBrush}" Width="22" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding BatteryText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BatteryEstimatedTimeText}" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <ProgressBar Value="{Binding BatteryPercent}" Minimum="0" Maximum="100" Height="6" Width="220" Margin="0,8,0,0"
                                                 Background="#1A1A24" Foreground="{StaticResource IslandSuccessBrush}" BorderThickness="0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="battery" Content="Power Options" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="mode_eco" Content="Eco Saver"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 6: NETWORK MONITOR                      -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsNetworkModule, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Path Data="{StaticResource GeoWifi}" Fill="{StaticResource IslandAccentSecondaryBrush}" Width="20" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ConnectionType}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding NetworkStatus}" FontSize="12" Foreground="{StaticResource IslandSuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding NetworkSpeedText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ping: 1.1.1.1 Active • Low Latency" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 7: SMART AI ISLAND                      -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsAiModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header with Quick Action Pills -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickAiActionCommand}" CommandParameter="summarize" Content="📋 Summarize" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickAiActionCommand}" CommandParameter="checklist" Content="✅ Checklist" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickAiActionCommand}" CommandParameter="plan" Content="🎯 Study Plan" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickAiActionCommand}" CommandParameter="tips" Content="⚡ Shortcuts" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickAiActionCommand}" CommandParameter="routine" Content="🤖 Routine" Padding="6,2" FontSize="9"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Column="1" Style="{StaticResource IslandWindowHeaderButtonStyle}" Command="{Binding ClearAiHistoryCommand}" ToolTip="Clear Conversation" Width="18" Height="18" Margin="4,0,0,0">
                                <Path Data="{StaticResource GeoClose}" Stroke="{StaticResource IslandDimForegroundBrush}" StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Conversation Chat Bubble Stream -->
                        <Border Grid.Row="1" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="8,6">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AiHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,4">
                                                    <!-- User Message Bubble (Right-aligned) -->
                                                    <Border HorizontalAlignment="Right" Background="#1E1E2C" BorderBrush="#2D2D42" BorderThickness="1"
                                                            CornerRadius="10,10,2,10" Padding="8,5" MaxWidth="300"
                                                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Content}" FontSize="10.5" Foreground="{StaticResource IslandForegroundBrush}" TextWrapping="Wrap"/>
                                                    </Border>

                                                    <!-- Assistant Message Bubble (Left-aligned) -->
                                                    <Border HorizontalAlignment="Left" Background="#14141C" BorderBrush="#222230" BorderThickness="1"
                                                            CornerRadius="10,10,10,2" Padding="8,5" MaxWidth="320"
                                                            Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Content}" FontSize="10.5" Foreground="{StaticResource IslandForegroundBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FormattedTime}" FontSize="8.5" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Thinking Status Overlay -->
                                <Border VerticalAlignment="Bottom" Background="#1A1A28" CornerRadius="8" Padding="8,3" BorderBrush="#3B82F6" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,2"
                                        Visibility="{Binding IsAiThinking, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoActivity}" Fill="{StaticResource IslandAccentPrimaryBrush}" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Thinking..." FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- AI Prompt Input Row -->
                        <Border Grid.Row="2" Background="#12121A" CornerRadius="10" Padding="8,4" BorderBrush="#1F1F2C" BorderThickness="1" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding AiPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="{StaticResource IslandForegroundBrush}"
                                         BorderThickness="0" FontSize="11" VerticalAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendAiPromptCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource IslandMediaSecondaryButtonStyle}" Command="{Binding SendAiPromptCommand}"
                                        Width="24" Height="24" Background="#1A1A26" BorderBrush="#2B2B3E" BorderThickness="1" ToolTip="Send Prompt (Enter)">
                                    <Path Data="{StaticResource GeoSend}" Fill="{StaticResource IslandAccentPrimaryBrush}" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 8: UNIVERSAL SEARCH                     -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsSearchModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Box Header -->
                        <Border Grid.Row="0" Background="#12121A" CornerRadius="10" Padding="10,6" BorderBrush="#1F1F2C" BorderThickness="1" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Stroke="{StaticResource IslandAccentPrimaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding UniversalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="{StaticResource IslandForegroundBrush}" BorderThickness="0" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Alt+Space" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource IslandDimForegroundBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Search Results Stream -->
                        <Border Grid.Row="1" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding UniversalSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14141C" CornerRadius="8" Padding="8,5" Margin="2,2" BorderBrush="#1E1E2A" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#1C1C2A" CornerRadius="5" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadge}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource IslandForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource IslandDimForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Style="{StaticResource IslandMediaSecondaryButtonStyle}"
                                                            Command="{Binding DataContext.ExecuteUniversalSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Width="48" Height="22" Background="#1C1C26" BorderBrush="#2D2D3E" BorderThickness="1" Margin="6,0,0,0">
                                                        <TextBlock Text="Open" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 9: SMART ROUTINES                       -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsRoutinesModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="SMART ROUTINES AUTOMATION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Windows Activity Auto Trigger" FontSize="9" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SmartRoutines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14141C" CornerRadius="9" Padding="8,6" Margin="2,2" BorderBrush="#1E1E2A" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                            <Border Background="#1A1A28" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TriggerBadge}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentSecondaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding LastStatus, StringFormat='Status: {0}'}" FontSize="8.5" Foreground="{StaticResource IslandAccentPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Style="{StaticResource IslandModePillButtonStyle}"
                                                                Command="{Binding DataContext.ToggleRoutineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Width="48" Height="22" Margin="0,0,4,0" Padding="0">
                                                            <TextBlock Text="{Binding IsEnabled, ConverterParameter='On:Off'}" FontSize="9"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IslandHeroPlayPauseButtonStyle}"
                                                                Command="{Binding DataContext.RunRoutineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Width="26" Height="26" ToolTip="Run Routine Now">
                                                            <Path Data="{StaticResource GeoPlay}" Fill="#FFFFFF" Width="7" Height="7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 10: QUICK LAUNCHER                      -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsLauncherModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Modern Search Box -->
                        <Border Grid.Row="0" Background="#12121A" CornerRadius="10" Padding="10,6" BorderBrush="#1F1F2C" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Stroke="{StaticResource IslandDimForegroundBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding LauncherQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="{StaticResource IslandForegroundBrush}" BorderThickness="0" FontSize="11.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredLauncherItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1A1A24" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IslandMediaSecondaryButtonStyle}"
                                                        Command="{Binding DataContext.LaunchItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Width="56" Height="26" Background="#1C1C26" BorderBrush="#2D2D3E" BorderThickness="1">
                                                    <TextBlock Text="Open" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 8: QUICK CONTROLS                       -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsControlsModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Realtime Windows Sound / Volume Control Card -->
                        <Border Grid.Row="0" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C28" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Mute / Unmute Button -->
                                <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource IslandWindowHeaderButtonStyle}"
                                        Command="{Binding ToggleSystemMuteCommand}" Width="28" Height="28" Margin="0,0,8,0"
                                        ToolTip="Click to Mute / Unmute Volume" VerticalAlignment="Center">
                                    <Grid>
                                        <Path Data="{StaticResource GeoSound}" Fill="{StaticResource IslandAccentPrimaryBrush}" Width="13" Height="13" Stretch="Uniform"
                                              Visibility="{Binding IsNotMuted, Converter={StaticResource BoolToVis}}"/>
                                        <Path Data="{StaticResource GeoSoundMute}" Fill="{StaticResource IslandErrorBrush}" Width="13" Height="13" Stretch="Uniform"
                                              Visibility="{Binding IsSystemMuted, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>

                                <!-- Output Device Name & Volume Label -->
                                <Grid Grid.Row="0" Grid.Column="1" Margin="2,0,0,2">
                                    <TextBlock Text="SOUND VOLUME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AudioOutputDeviceName}" FontSize="8.5" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                </Grid>

                                <!-- Realtime System Volume Slider -->
                                <Slider Grid.Row="1" Grid.Column="1" Value="{Binding SystemVolume, Mode=TwoWay}"
                                        Minimum="0" Maximum="100" Style="{StaticResource IslandSliderStyle}"
                                        Margin="2,0,6,0" VerticalAlignment="Center"/>

                                <!-- Percentage Display -->
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SystemVolume, StringFormat='{}{0}%'}"
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}"
                                           Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Realtime Screen Brightness Control Card -->
                        <Border Grid.Row="1" Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C28" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,5">
                            <Grid>
                                <!-- When Brightness is Supported -->
                                <Grid Visibility="{Binding IsBrightnessSupported, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Sun / Brightness Icon -->
                                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Width="28" Height="28" Background="#161622" BorderBrush="#252538" BorderThickness="1" CornerRadius="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoBrightness}" Stroke="{StaticResource IslandWarningBrush}" StrokeThickness="1.2" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Title & Method Label -->
                                    <Grid Grid.Row="0" Grid.Column="1" Margin="2,0,0,2">
                                        <TextBlock Text="DISPLAY BRIGHTNESS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource IslandWarningBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Hardware WMI Control" FontSize="8.5" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Realtime Brightness Slider -->
                                    <Slider Grid.Row="1" Grid.Column="1" Value="{Binding ScreenBrightness, Mode=TwoWay}"
                                            Minimum="0" Maximum="100" Style="{StaticResource IslandSliderStyle}"
                                            Margin="2,0,6,0" VerticalAlignment="Center"/>

                                    <!-- Percentage Display -->
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ScreenBrightness, StringFormat='{}{0}%'}"
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}"
                                               Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Fallback When Brightness is Unavailable -->
                                <Grid Visibility="{Binding IsBrightnessUnavailable, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="28" Height="28" Background="#1E1418" BorderBrush="#3D2026" BorderThickness="1" CornerRadius="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoBrightness}" Stroke="{StaticResource IslandDimForegroundBrush}" StrokeThickness="1.2" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Brightness control unavailable" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource IslandDimForegroundBrush}"/>
                                        <TextBlock Text="External or fixed display detected" FontSize="8.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource IslandModePillButtonStyle}"
                                            Command="{Binding OpenDisplaySettingsCommand}" Content="Settings"
                                            Padding="6,2" FontSize="9" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Quick Toggle Tiles -->
                        <Grid Grid.Row="2" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource IslandTileButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="wifi" Padding="4" Margin="0,0,3,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource GeoWifi}" Fill="{StaticResource IslandForegroundBrush}" Width="12" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Wi-Fi" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource IslandTileButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="bluetooth" Padding="4" Margin="3,0,3,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource GeoBluetooth}" Fill="{StaticResource IslandForegroundBrush}" Width="9" Height="11" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Bluetooth" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource IslandTileButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="battery" Padding="4" Margin="3,0,3,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource GeoBattery}" Fill="{StaticResource IslandForegroundBrush}" Width="12" Height="9" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Battery" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Style="{StaticResource IslandTileButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="nightlight" Padding="4" Margin="3,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource GeoMoon}" Fill="{StaticResource IslandForegroundBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Night Light" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Activity Mode Selector -->
                        <Border Grid.Row="3" Background="#111116" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="8" Padding="6,3" Margin="0,3,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ActiveModeName, StringFormat='Profile: {0}'}"
                                           FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="mode_eco" Content="Eco" Padding="6,2" Margin="0,0,3,0" FontSize="9"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="mode_balanced" Content="Balanced" Padding="6,2" Margin="0,0,3,0" FontSize="9"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="mode_performance" Content="Turbo" Padding="6,2" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 9: NOTIFICATION CENTER                  -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsNotificationsModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="NOTIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding ClearNotificationsCommand}" Content="Clear All" HorizontalAlignment="Right" FontSize="9.5" Padding="6,2"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IslandWindowHeaderButtonStyle}"
                                                        Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Width="20" Height="20" Margin="4,0,0,0">
                                                    <Path Data="{StaticResource GeoClose}" Stroke="{StaticResource IslandDimForegroundBrush}" StrokeThickness="1.5" Width="6" Height="6" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 10: CLIPBOARD HISTORY                   -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsClipboardModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="RECENT CLIPS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding ClearClipboardCommand}" Content="Clear All" FontSize="9.5" Foreground="{StaticResource IslandErrorBrush}" Padding="6,2" HorizontalAlignment="Right"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ClipboardItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PreviewText}" FontSize="10.5" Foreground="{StaticResource IslandForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Style="{StaticResource IslandMediaSecondaryButtonStyle}"
                                                        Command="{Binding DataContext.CopyClipboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Width="48" Height="22" Padding="4,1" Margin="6,0,0,0">
                                                    <TextBlock Text="Copy" FontSize="9.5" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 11: WEATHER                             -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsWeatherModule, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="14" Padding="16" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <Path Data="{StaticResource GeoWeather}" Fill="#F59E0B" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding WeatherTempText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding WeatherCondition}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding WeatherCity, StringFormat='Location: {0}'}" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding WeatherHumidity, StringFormat='Humidity: {0}'}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding WeatherWind, StringFormat='Wind: {0}'}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}"/>
                                </StackPanel>
                                <Border Background="#161622" CornerRadius="6" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Center" BorderBrush="#252538" BorderThickness="1">
                                    <TextBlock Text="{Binding WeatherLastUpdatedText}" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 12: AGENDA & REMINDERS                  -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsCalendarModule, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReminderItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                    <TextBlock Text="{Binding DueDate, StringFormat='Due: {0:g}'}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IslandMediaSecondaryButtonStyle}"
                                                        Command="{Binding DataContext.CompleteReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Width="58" Height="24" Padding="4,1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource GeoCheck}" Stroke="{StaticResource IslandSuccessBrush}" StrokeThickness="1.5" Width="8" Height="7" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBlock Text="Done" FontSize="9.5" Foreground="{StaticResource IslandSuccessBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 13: FOCUS & POMODORO                    -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsFocusModule, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Timer & Badge -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,2">
                            <Border Background="#14141C" CornerRadius="7" Padding="8,2" BorderBrush="#222230" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="{Binding FocusStageText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding FocusTimeFormatted}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Progress Bar -->
                        <ProgressBar Grid.Row="1" Value="{Binding FocusProgress}" Minimum="0" Maximum="1" Height="3.5"
                                     Background="#161620" Foreground="{StaticResource IslandAccentGradient}" Margin="40,0,40,10" BorderThickness="0"/>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource IslandHeroPlayPauseButtonStyle}" Command="{Binding StartPomodoroCommand}"
                                    Width="100" Height="32" BorderBrush="#3B82F6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoPlay}" Fill="#FFFFFF" Width="8" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Start" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IslandMediaSecondaryButtonStyle}" Command="{Binding PauseTimerCommand}" Width="72" Height="32" Margin="0,0,8,0">
                                <TextBlock Text="Pause" FontSize="10.5" Foreground="{StaticResource IslandForegroundBrush}"/>
                            </Button>
                            <Button Style="{StaticResource IslandMediaSecondaryButtonStyle}" Command="{Binding ResetTimerCommand}" Width="72" Height="32">
                                <TextBlock Text="Reset" FontSize="10.5" Foreground="{StaticResource IslandMutedForegroundBrush}"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="{Binding TodayFocusMinutes, StringFormat='Today focused: {0} minutes'}"
                                   FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,0"/>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 14: SMART ACTIVITY ISLAND               -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsActivityModule, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Path Data="{StaticResource GeoActivity}" Fill="{StaticResource IslandWarningBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Active Island Operations" FontSize="12" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Real-time multi-tasking progress monitor" FontSize="10" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ActiveTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14141C" CornerRadius="8" Padding="8" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                        <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="4" Margin="0,4,0,0"
                                                                     Foreground="{StaticResource IslandAccentGradient}" Background="#1C1C26" BorderThickness="0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource IslandWindowHeaderButtonStyle}"
                                                            Command="{Binding DataContext.CancelActivityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Width="20" Height="20" Margin="6,0,0,0">
                                                        <Path Data="{StaticResource GeoClose}" Stroke="{StaticResource IslandErrorBrush}" StrokeThickness="1.5" Width="6" Height="6" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 15: GAMING MODE                         -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsGamingModule, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoGame}" Fill="{StaticResource IslandAccentSecondaryBrush}" Width="32" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Gaming Optimization Active" FontSize="13" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding GameProcessName, StringFormat='Foreground App: {0}'}" FontSize="11" Foreground="{StaticResource IslandAccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="Auto Low Polling • Suppressed Notifications • Minimum Latency" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 16: FILE DROP ZONE                      -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsFileDropModule, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Path Data="{StaticResource GeoFileDrop}" Fill="{StaticResource IslandAccentPrimaryBrush}" Width="16" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Drag and Drop Files Directly Here" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DroppedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#14141C" CornerRadius="8" Padding="6,4" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource IslandForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SizeString}" FontSize="9" Foreground="{StaticResource IslandDimForegroundBrush}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource IslandMediaSecondaryButtonStyle}"
                                                                Command="{Binding DataContext.OpenDroppedFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Width="48" Height="22">
                                                            <TextBlock Text="Open" FontSize="9.5" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 17: THEMES & ISLAND SETUP               -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsThemesModule, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2">
                                <!-- Official NexIsland Branding Header -->
                                <Border Background="#12121A" CornerRadius="10" Padding="10,8" Margin="0,0,0,10" BorderBrush="#1C1C28" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="Assets/Branding/NexIslandLogo.png" Height="28" Stretch="Uniform" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="NexIsland Dynamic Island" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IslandForegroundBrush}"/>
                                            <TextBlock Text="Windows 10/11 • Swipe Navigation Active" FontSize="9" Foreground="{StaticResource IslandDimForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="DYNAMIC THEME PRESETS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="mode_eco" Content="Obsidian" Margin="0,0,4,4"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="mode_balanced" Content="Cyber Cyan" Margin="0,0,4,4"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding QuickControlCommand}" CommandParameter="mode_performance" Content="Crimson" Margin="0,0,4,4"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Content="Aurora" Margin="0,0,4,4"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Content="Light Frost" Margin="0,0,4,4"/>
                                </WrapPanel>

                                <!-- In-Island Module Sequence Management -->
                                <Grid Margin="0,4,0,6">
                                    <TextBlock Text="SWIPE MODULE SEQUENCE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource IslandModePillButtonStyle}" Command="{Binding ResetModuleOrderCommand}" Content="Reset Order" HorizontalAlignment="Right" Padding="8,2" FontSize="9.5"/>
                                </Grid>
                                <Border Background="#12121A" CornerRadius="8" Padding="6,4" Margin="0,0,0,10" BorderBrush="#1C1C26" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding ModuleOrderList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource IslandForegroundBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource IslandWindowHeaderButtonStyle}" Command="{Binding DataContext.MoveModuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="16" Height="16" ToolTip="Move Module Up" Margin="0,0,3,0">
                                                            <TextBlock Text="▲" FontSize="7" Foreground="{StaticResource IslandMutedForegroundBrush}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IslandWindowHeaderButtonStyle}" Command="{Binding DataContext.MoveModuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="16" Height="16" ToolTip="Move Module Down">
                                                            <TextBlock Text="▼" FontSize="7" Foreground="{StaticResource IslandMutedForegroundBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="SYSTEM &amp; BEHAVIOR" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}" Margin="0,4,0,6"/>
                                <CheckBox Content="Start NexIsland automatically with Windows" IsChecked="{Binding StartWithWindows}" Foreground="{StaticResource IslandForegroundBrush}" Margin="0,0,0,6" FontSize="10.5"/>
                                <CheckBox Content="Keep Dynamic Island Always on Top" IsChecked="{Binding AlwaysOnTop}" Foreground="{StaticResource IslandForegroundBrush}" Margin="0,0,0,6" FontSize="10.5"/>
                                <CheckBox Content="Lock Island Position (Prevent Drag)" IsChecked="{Binding LockPosition}" Foreground="{StaticResource IslandForegroundBrush}" Margin="0,0,0,6" FontSize="10.5"/>
                                <CheckBox Content="Reduced Motion Mode (Low GPU)" IsChecked="{Binding ReducedMotion}" Foreground="{StaticResource IslandForegroundBrush}" FontSize="10.5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- MODULE 18: PLUGIN SYSTEM                       -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding IsPluginsModule, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Plugins}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource IslandPanelBrush}" BorderBrush="#1C1C26" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Metadata.Name}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource IslandForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Metadata.Description}" FontSize="9.5" Foreground="{StaticResource IslandDimForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IslandModePillButtonStyle}"
                                                        Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Width="60" Height="26">
                                                    <TextBlock Text="{Binding IsEnabled, ConverterParameter='Enabled:Disabled'}" FontSize="9.5"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Bottom Quick Navigation Bar (Clickable Module Selector) -->
                <Border Grid.Row="2" Margin="0,6,0,0" Padding="0,4,0,0" BorderBrush="#1C1C28" BorderThickness="0,1,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Music" Content="🎵 Music" ToolTip="Music Player"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Controls" Content="🎛️ Controls" ToolTip="Brightness &amp; Volume"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Lyrics" Content="🎤 Lyrics" ToolTip="Live Lyrics"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="System" Content="📊 System" ToolTip="Hardware Stats"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Focus" Content="⏱️ Focus" ToolTip="Pomodoro Timer"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Ai" Content="🤖 AI" ToolTip="AI Copilot"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Weather" Content="🌤️ Weather" ToolTip="Weather Forecast"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Launcher" Content="🚀 Apps" ToolTip="App Launcher"/>
                            <Button Style="{StaticResource IslandModuleTabButtonStyle}" Command="{Binding SelectModuleCommand}" CommandParameter="Themes" Content="⚙️ Themes" ToolTip="Themes &amp; Settings"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 4. FLOATING UNIVERSAL SEARCH OVERLAY           -->
            <!-- ============================================== -->
            <Grid x:Name="UniversalSearchOverlay"
                  Visibility="{Binding IsUniversalSearchOpen, Converter={StaticResource BoolToVis}}"
                  Background="#EE0B0B12" Margin="0">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar with Glowing Accent Border -->
                    <Border Grid.Row="0" Background="#14141E" CornerRadius="12" Padding="12,8" BorderBrush="#3B82F6" BorderThickness="1.5" Margin="0,0,0,8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Color="#3B82F6" Opacity="0.35" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Stroke="{StaticResource IslandAccentPrimaryBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding UniversalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="{StaticResource IslandForegroundBrush}" BorderThickness="0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource IslandWindowHeaderButtonStyle}" Command="{Binding CloseUniversalSearchCommand}" ToolTip="Close Search (Esc)" Width="20" Height="20">
                                <Path Data="{StaticResource GeoClose}" Stroke="{StaticResource IslandDimForegroundBrush}" StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Search Results with Arrow Navigation & Click -->
                    <Border Grid.Row="1" Background="#101018" CornerRadius="12" Padding="4" BorderBrush="#1E1E2C" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UniversalSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IslandWindowHeaderButtonStyle}"
                                                Command="{Binding DataContext.ExecuteUniversalSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch" Width="Auto" Height="Auto" Margin="2,2" Padding="0">
                                            <Border Background="#151522" CornerRadius="8" Padding="10,6" BorderBrush="#222234" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#1D1D2C" CornerRadius="5" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadge}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource IslandAccentPrimaryBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource IslandForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource IslandDimForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="↵" FontSize="12" Foreground="{StaticResource IslandDimForegroundBrush}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
